#!name=网上国网-接口版
#!desc=供 Scripting 调用网上国网查询接口；无定时任务
#!author=Timkeltis + Yuheng0101/X
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/83/d8/8a/83d88a92-5a4d-7a2f-118c-80d795e7a9f6/AppIcon-0-0-1x_U007emarketing-0-5-0-0-sRGB-85-220.png/144x144.png
#!tag=网上国网,Scripting,接口

[Argument]
sgcc_enable=switch, true, tag=接口重写开关, desc=供 Scripting 调用时保持开启
username=input, "", tag=登录账号, desc=网上国网网站或App登录账号
password=input, "", tag=登录密码, desc=网上国网登录密码
debug=switch, true, tag=调试模式, desc=排错时建议开启
show_recent_usage=switch, false, tag=展示近期用量, desc=返回近期用电数据
notify_all_accounts=switch, false, tag=全部户号, desc=多户号时返回全部户号
timeout=input, "60", tag=超时时间, desc=单次接口处理最大秒数

[Script]
# Scripting -> 本地伪接口 -> 自有修正版 95598.js -> 返回 JSON
http-request ^https?:\/\/api\.wsgw-rewrite\.com\/electricity\/bill\/all script-path=https://raw.githubusercontent.com/Timkeltis/SGCC/main/95598.js, requires-body=true, timeout={timeout}, tag=网上国网接口, enable={sgcc_enable}, argument=[{username},{password},{debug},{show_recent_usage},{notify_all_accounts}]

[MITM]
hostname=api.wsgw-rewrite.com
